{
  "name": "mf-workspace",
  "private": true,
  "workspaces": [
    "packages/*",
    "app/*"
  ],
  "scripts": {
    "clean": "rimraf node_modules packages/*/node_modules app/*/node_modules",
    "install:all": "npm install",
    "start": "concurrently \"npm start --workspace packages/shared-ui\" \"npm start --workspace packages/form-designer\" \"npm start --workspace packages/dashboard\" \"npm start --workspace app/shell\""
  },
  "devDependencies": {
    "@reduxjs/toolkit": "^2.1.0",
    "@tailwindcss/postcss": "^4.1.18",
    "autoprefixer": "^10.4.23",
    "concurrently": "^8.2.0",
    "postcss": "^8.5.6",
    "postcss-loader": "^8.2.0",
    "react-redux": "^9.1.0",
    "react-router-dom": "^6.22.0",
    "rimraf": "^5.0.10",
    "style-loader": "^4.0.0",
    "tailwindcss": "^4.1.18"
  },
  "dependencies": {
    "css-loader": "^7.1.2"
  }
}
